# Virtual environments
.venv/
venv/
ENV/
env/

# Python cache & build files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/

# Datasets and large binary arrays  (PTB-XL waveforms; never commit raw data)
data/*
!data/.gitkeep
!data/README.md
*.zip
*.tar.gz
*.npz

# -----------------------------------------------------------------------
# Model checkpoints are stored via Git LFS (*.pth, *.pt tracked in .gitattributes).
# Do NOT add blanket *.pth / checkpoints/* ignores here — that would hide
# LFS-tracked files from git status.
# -----------------------------------------------------------------------

# Scratch & temporary development files
_scratch*
audit_fix_done.txt
scratch_*
scratch_val_test_probs.npz

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.log
